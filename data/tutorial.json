{
  "revision": 10,
  "steps": [
    { "id": "buy", "text": "Buy a booster.", "target": "[data-action='buy'][data-n='1']", "tab": "shop", "done": "boostersBought" },
    { "id": "open", "text": "Open it.", "target": "[data-action='open'][data-n='1']", "tab": "shop", "done": "boostersOpened" },
    { "id": "price-showcase", "text": "Your cards are in the binder. Price them for the showcase.", "target": "[data-action='price']", "tab": "shop", "done": "cardsPriced" },
    { "id": "sale", "text": "Customers buy on their own. Cheaper tags sell faster.", "target": "#stage-price", "tab": "shop", "done": "cardsSold" },
    { "id": "customers", "text": "Customers tell you what they think of your prices. See them in the Showcase.", "target": "[data-tab='showcase']", "when": "showcaseUnlocked", "done": "visitedShowcase" },
    { "id": "hire", "text": "Hire your first employee.", "target": "[data-action='hire']", "tab": "staff", "when": "staffUnlocked", "done": "hasStaff" },
    { "id": "task", "text": "Pick a job for them.", "target": ".emp select", "tab": "staff", "when": "hasStaff", "done": "staffHasTask" },
    { "id": "backup", "text": "Give them a backup job for when the main one runs out.", "target": ".job select[data-slot='2']", "tab": "staff", "when": "twoStaff", "done": "hasBackupJob" },
    { "id": "market", "text": "Card prices change every market day, every 10 minutes. Check the Market.", "target": "[data-tab='market']", "when": "marketUnlocked", "done": "visitedMarket" },
    { "id": "supply", "text": "Boosters have a limited supply. Less supply, higher price. Buy and sell them here.", "target": ".boosters", "tab": "market", "when": "visitedMarket", "done": "tradedBooster" },
    { "id": "settings", "text": "Theme, volume and save are in Settings.", "target": "[data-tab='settings']", "when": "hasStaff", "done": "visitedSettings" },
    { "id": "news", "text": "New collections, reprints and updates show up in News.", "target": "#news-btn", "when": "hasStaff", "done": "visitedNews" },
    { "id": "salary", "text": "Staff earn a salary every market day. See income and costs in Finances.", "target": "[data-tab='finances']", "when": "hasStaff", "done": "visitedFinances" },
    { "id": "storage", "text": "Sell sealed boosters, boxes and accessories from Storage.", "target": "[data-tab='storage']", "when": "storageUnlocked", "done": "visitedStorage" },
    { "id": "shelf", "text": "Set a price and list goods on the shelf. Customers buy them too.", "target": ".goods", "tab": "storage", "when": "visitedStorage", "done": "listedGood" },
    { "id": "marketing", "text": "Run a campaign for more customers for a few days.", "target": "[data-tab='marketing']", "when": "marketingUnlocked", "done": "visitedMarketing" },
    { "id": "properties", "text": "Warehouses hold far more goods, restock the shop and take what you and your buyer buy once the shop is full.", "target": "[data-tab='properties']", "when": "propertiesUnlocked", "done": "visitedProperties" },
    { "id": "nextset", "text": "A new collection is out. Some customers come only for it, so put a few in the showcase.", "target": "[data-action='shop-set']", "tab": "shop", "when": "nextSetOpen", "done": "boughtNextSet" }
  ]
}
